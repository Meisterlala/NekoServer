{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "schedule": ["before 6am"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "description": "Keep all dependency updates together so Renovate opens one PR.",
      "groupName": "dependencies",
      "matchPackageNames": ["*"]
    }
  ]
}
